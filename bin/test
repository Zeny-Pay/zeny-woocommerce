#!/usr/bin/env bash
# Runs the test suites in Docker, so no local PHP is needed.
#   bin/test              unit tests on PHP 7.4 and 8.3, then the integration suite
#   bin/test unit [7.4]   unit tests on one PHP version (default: both)
#   bin/test integration [phpunit args]  WordPress + WooCommerce + stub Zeny API (docker compose),
#                         on the posts and the HPOS order store (ORDER_STORES="hpos" for one)
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

[ -d "$root/vendor" ] || "$root/bin/composer" install --no-interaction --no-progress

unit() {
	echo "== unit tests, PHP $1"
	docker run --rm -u "$(id -u):$(id -g)" -v "$root:/app" -w /app "php:$1-cli" \
		php vendor/bin/phpunit --testsuite unit
}

integration() {
	local compose=(docker compose -f "$root/docker-compose.test.yml" --project-directory "$root" -p zeny-wc-test)
	trap '"${compose[@]}" down -v --remove-orphans >/dev/null 2>&1 || true' EXIT
	for store in ${ORDER_STORES:-posts hpos}; do
		echo "== integration tests, $store order store"
		"${compose[@]}" down -v --remove-orphans >/dev/null 2>&1 || true
		"${compose[@]}" run --rm -e ORDER_STORE="$store" wordpress bash /plugin/tests/Integration/run.sh "$@"
	done
}

case "${1:-all}" in
	unit) if [ -n "${2:-}" ]; then unit "$2"; else unit 7.4; unit 8.3; fi ;;
	integration) shift; integration "$@" ;;
	all) unit 7.4; unit 8.3; integration ;;
	*) echo "usage: bin/test [unit [7.4|8.3] | integration]" >&2; exit 2 ;;
esac
