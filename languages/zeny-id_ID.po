#. Plugin Name of the plugin
#: zeny-woocommerce.php
msgid "Zeny for WooCommerce"
msgstr "Zeny untuk WooCommerce"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: zeny-woocommerce.php
msgid "https://usezeny.com"
msgstr "https://usezeny.com"

#. Description of the plugin
#: zeny-woocommerce.php
msgid "Take payments through Zeny payment links. Shoppers choose QRIS, virtual account or e-wallet on the Zeny pay page."
msgstr "Terima pembayaran lewat tautan pembayaran Zeny. Pembeli memilih QRIS, virtual account, atau e-wallet di halaman pembayaran Zeny."

#. Author of the plugin
#: zeny-woocommerce.php
#: src/WooCommerce/Gateway.php:33
#: src/WooCommerce/OrderMetaBox.php:33
msgid "Zeny"
msgstr "Zeny"

#: src/WooCommerce/AdminNotices.php:33
msgid "Zeny:"
msgstr "Zeny:"

#. translators: %s: store currency code.
#: src/WooCommerce/AdminNotices.php:52
#, php-format
msgid "The store currency is %s, but Zeny takes Indonesian rupiah (IDR) only, so Zeny is hidden at checkout. Set the currency under WooCommerce > Settings > General."
msgstr "Mata uang toko adalah %s, sedangkan Zeny hanya menerima rupiah (IDR), jadi Zeny disembunyikan saat checkout. Atur mata uang di WooCommerce > Pengaturan > Umum."

#: src/WooCommerce/AdminNotices.php:56
msgid "There is no valid secret API key, so Zeny is hidden at checkout. Add the key under WooCommerce > Settings > Payments > Zeny."
msgstr "Belum ada secret API key yang valid, jadi Zeny disembunyikan saat checkout. Tambahkan key di WooCommerce > Pengaturan > Pembayaran > Zeny."

#: src/WooCommerce/AdminNotices.php:59
msgid "There is no webhook secret, so paid orders are not updated. Add the webhook endpoint in the Zeny dashboard and paste its secret under WooCommerce > Settings > Payments > Zeny."
msgstr "Belum ada webhook secret, jadi pesanan yang sudah dibayar tidak diperbarui. Tambahkan endpoint webhook di dasbor Zeny, lalu tempel secret-nya di WooCommerce > Pengaturan > Pembayaran > Zeny."

#: src/WooCommerce/AdminNotices.php:62
msgid "The store is not on https. Shoppers are not sent back to the store after paying, and Zeny sends webhooks to https addresses only, so orders are not marked paid on their own. Move the store to https, or confirm each payment on the order screen with its Zeny payment id."
msgstr "Toko belum memakai https. Pembeli tidak dikembalikan ke toko setelah membayar, dan Zeny hanya mengirim webhook ke alamat https, jadi pesanan tidak ditandai lunas dengan sendirinya. Pindahkan toko ke https, atau konfirmasi setiap pembayaran di layar pesanan dengan ID pembayaran Zeny-nya."

#: src/WooCommerce/Gateway.php:34
msgid "Shoppers pay on a Zeny payment link with QRIS, a virtual account or an e-wallet. Orders are marked paid when Zeny confirms the payment."
msgstr "Pembeli membayar di tautan pembayaran Zeny dengan QRIS, virtual account, atau e-wallet. Pesanan ditandai lunas setelah Zeny mengonfirmasi pembayaran."

#: src/WooCommerce/Gateway.php:75
msgid "Zeny is not available for this order. Choose another payment method."
msgstr "Zeny tidak tersedia untuk pesanan ini. Pilih metode pembayaran lain."

#: src/WooCommerce/Gateway.php:108
msgid "Saved. Leave blank to keep it."
msgstr "Tersimpan. Kosongkan untuk tetap memakainya."

#: src/WooCommerce/Gateway.php:142
msgid "The secret API key must start with sk_test_ or sk_live_. The saved key was kept."
msgstr "Secret API key harus diawali sk_test_ atau sk_live_. Key yang tersimpan tetap dipakai."

#: src/WooCommerce/Gateway.php:160
msgid "The webhook secret must start with whsec_. The saved secret was kept."
msgstr "Webhook secret harus diawali whsec_. Secret yang tersimpan tetap dipakai."

#. translators: %s: the codes that were removed.
#: src/WooCommerce/Gateway.php:190
#, php-format
msgid "These payment method codes were removed because they are not valid: %s"
msgstr "Kode metode pembayaran berikut dihapus karena tidak valid: %s"

#. translators: %s: payment link id.
#: src/WooCommerce/LinkCanceller.php:70
#, php-format
msgid "Zeny payment link %s canceled."
msgstr "Tautan pembayaran Zeny %s dibatalkan."

#. translators: %s: payment link id.
#: src/WooCommerce/LinkCanceller.php:83
#, php-format
msgid "Zeny payment link %s took a payment, so it was not canceled. Check the payment in the Zeny dashboard and refund it there if needed."
msgstr "Tautan pembayaran Zeny %s sudah menerima pembayaran, jadi tidak dibatalkan. Periksa pembayarannya di dasbor Zeny dan kembalikan dananya di sana bila perlu."

#. translators: %s: payment link id.
#: src/WooCommerce/LinkCanceller.php:85
#, php-format
msgid "Zeny could not cancel payment link %s. It stops taking payments when it expires."
msgstr "Zeny tidak dapat membatalkan tautan pembayaran %s. Tautan berhenti menerima pembayaran saat kedaluwarsa."

#: src/WooCommerce/LinkCheckout.php:101
msgid "Zeny takes payments in Indonesian rupiah (IDR) only."
msgstr "Zeny hanya menerima pembayaran dalam rupiah (IDR)."

#: src/WooCommerce/LinkCheckout.php:104
msgid "This order is already being sent to Zeny. Wait a moment, then try again."
msgstr "Pesanan ini sedang dikirim ke Zeny. Tunggu sebentar, lalu coba lagi."

#: src/WooCommerce/LinkCheckout.php:112
msgid "We could not start the Zeny payment for this order. Contact us to complete your order."
msgstr "Kami tidak dapat memulai pembayaran Zeny untuk pesanan ini. Hubungi kami untuk menyelesaikan pesanan Anda."

#. translators: 1: payment link id, 2: Sandbox or Production.
#: src/WooCommerce/LinkCheckout.php:190
#, php-format
msgid "Zeny payment link %1$s created (%2$s). Waiting for the shopper to pay."
msgstr "Tautan pembayaran Zeny %1$s dibuat (%2$s). Menunggu pembeli membayar."

#. translators: 1: order number, 2: shop name.
#: src/WooCommerce/LinkCheckout.php:240
#, php-format
msgid "Order #%1$s – %2$s"
msgstr "Pesanan #%1$s – %2$s"

#. translators: 1: error code, 2: request id.
#: src/WooCommerce/LinkCheckout.php:274
#, php-format
msgid "Zeny could not create the payment link: %1$s (request %2$s)."
msgstr "Zeny tidak dapat membuat tautan pembayaran: %1$s (request %2$s)."

#. translators: %s: reference to quote to support.
#: src/WooCommerce/LinkCheckout.php:279
#, php-format
msgid "We could not start the Zeny payment. Please try again. If it keeps failing, contact us and quote reference %s."
msgstr "Kami tidak dapat memulai pembayaran Zeny. Silakan coba lagi. Jika masih gagal, hubungi kami dan sebutkan referensi %s."

#: src/WooCommerce/LinkCheckout.php:288
msgid "Production"
msgstr "Produksi"

#: src/WooCommerce/LinkCheckout.php:288
msgid "Sandbox"
msgstr "Sandbox"

#. translators: 1: new payment id, 2: payment id the order was paid with.
#: src/WooCommerce/OrderCompleter.php:108
#, php-format
msgid "Zeny payment %1$s arrived for this order, which is already paid by %2$s. The shopper may have paid twice: check both payments in the Zeny dashboard and refund one there."
msgstr "Pembayaran Zeny %1$s masuk untuk pesanan ini, padahal pesanan sudah dibayar dengan %2$s. Pembeli mungkin membayar dua kali: periksa kedua pembayaran di dasbor Zeny dan kembalikan salah satunya di sana."

#. translators: 1: payment id, 2: Sandbox or Production.
#: src/WooCommerce/OrderCompleter.php:127
#, php-format
msgid "Zeny payment %1$s received (%2$s)."
msgstr "Pembayaran Zeny %1$s diterima (%2$s)."

#. translators: %s: payment id.
#: src/WooCommerce/OrderCompleter.php:158
#, php-format
msgid "Zeny payment %s does not match the order total in IDR."
msgstr "Pembayaran Zeny %s tidak sama dengan total pesanan dalam IDR."

#. translators: %s: payment id.
#: src/WooCommerce/OrderCompleter.php:162
#, php-format
msgid "Zeny payment %s comes from another environment (Sandbox or Production) than the saved API key."
msgstr "Pembayaran Zeny %s berasal dari lingkungan (Sandbox atau Produksi) yang berbeda dengan API key yang tersimpan."

#. translators: %s: payment id.
#: src/WooCommerce/OrderCompleter.php:166
#, php-format
msgid "Zeny payment %s was not made through this order's payment link."
msgstr "Pembayaran Zeny %s tidak dilakukan lewat tautan pembayaran pesanan ini."

#. translators: %s: payment id.
#: src/WooCommerce/OrderCompleter.php:170
#, php-format
msgid "Zeny payment %s is not paid."
msgstr "Pembayaran Zeny %s belum lunas."

#. translators: %s: payment id.
#: src/WooCommerce/OrderCompleter.php:174
#, php-format
msgid "Zeny payment %s was received after the order was cancelled."
msgstr "Pembayaran Zeny %s diterima setelah pesanan dibatalkan."

#: src/WooCommerce/OrderCompleter.php:176
msgid "The order was not marked paid. Check the payment in the Zeny dashboard, then complete or refund it."
msgstr "Pesanan tidak ditandai lunas. Periksa pembayarannya di dasbor Zeny, lalu selesaikan pesanan atau kembalikan dananya."

#: src/WooCommerce/OrderMetaBox.php:45
msgid "This order was not paid with Zeny."
msgstr "Pesanan ini tidak dibayar dengan Zeny."

#: src/WooCommerce/OrderMetaBox.php:50
msgid "Payment link"
msgstr "Tautan pembayaran"

#: src/WooCommerce/OrderMetaBox.php:51
msgid "Link URL"
msgstr "URL tautan"

#: src/WooCommerce/OrderMetaBox.php:52
#: src/WooCommerce/SettingsPanel.php:34
msgid "Mode"
msgstr "Mode"

#: src/WooCommerce/OrderMetaBox.php:53
msgid "Payment"
msgstr "Pembayaran"

#: src/WooCommerce/OrderMetaBox.php:67
msgid "Confirm with a Zeny payment id"
msgstr "Konfirmasi dengan ID pembayaran Zeny"

#: src/WooCommerce/OrderMetaBox.php:75
msgid "Checking…"
msgstr "Memeriksa…"

#: src/WooCommerce/OrderMetaBox.php:76
msgid "The check could not run. Reload the page and try again."
msgstr "Pemeriksaan tidak dapat dijalankan. Muat ulang halaman dan coba lagi."

#: src/WooCommerce/OrderMetaBox.php:76
msgid "Confirm payment"
msgstr "Konfirmasi pembayaran"

#: src/WooCommerce/OrderMetaBox.php:79
msgid "Use this only when the webhook did not arrive. The payment must be paid through this order's link for the order total."
msgstr "Gunakan ini hanya jika webhook tidak masuk. Pembayaran harus lunas lewat tautan pesanan ini sebesar total pesanan."

#: src/WooCommerce/OrderMetaBox.php:90
#: src/WooCommerce/SettingsPanel.php:66
msgid "You are not allowed to do this."
msgstr "Anda tidak diizinkan melakukan ini."

#: src/WooCommerce/OrderMetaBox.php:95
msgid "Order not found."
msgstr "Pesanan tidak ditemukan."

#: src/WooCommerce/OrderMetaBox.php:99
msgid "Payment confirmed. Reloading…"
msgstr "Pembayaran dikonfirmasi. Memuat ulang…"

#: src/WooCommerce/OrderMetaBox.php:114
#: src/WooCommerce/SettingsPanel.php:85
msgid "Save a valid secret API key first."
msgstr "Simpan secret API key yang valid terlebih dahulu."

#: src/WooCommerce/OrderMetaBox.php:119
msgid "A Zeny payment id starts with pay_."
msgstr "ID pembayaran Zeny diawali pay_."

#. translators: 1: error code, 2: request id.
#: src/WooCommerce/OrderMetaBox.php:122
#, php-format
msgid "Zeny could not return that payment: %1$s (request %2$s)."
msgstr "Zeny tidak dapat memberikan pembayaran tersebut: %1$s (request %2$s)."

#: src/WooCommerce/OrderMetaBox.php:127
msgid "The order is being updated. Try again in a moment."
msgstr "Pesanan sedang diperbarui. Coba lagi sebentar lagi."

#: src/WooCommerce/OrderMetaBox.php:143
msgid "The order is already paid."
msgstr "Pesanan sudah lunas."

#: src/WooCommerce/OrderMetaBox.php:145
msgid "That payment does not pay this order: it must be paid, through this order's payment link, for the order total, in the same environment as the saved key."
msgstr "Pembayaran itu tidak melunasi pesanan ini: pembayaran harus lunas, lewat tautan pembayaran pesanan ini, sebesar total pesanan, dan di lingkungan yang sama dengan key yang tersimpan."

#: src/WooCommerce/Plugin.php:146
msgid "Zeny for WooCommerce needs WooCommerce. Install and activate WooCommerce to take Zeny payments."
msgstr "Zeny untuk WooCommerce membutuhkan WooCommerce. Pasang dan aktifkan WooCommerce untuk menerima pembayaran Zeny."

#: src/WooCommerce/ReturnHandler.php:41
msgid "We have not received the confirmation yet. You will get an email once your payment is confirmed."
msgstr "Kami belum menerima konfirmasinya. Anda akan menerima email setelah pembayaran dikonfirmasi."

#: src/WooCommerce/ReturnHandler.php:46
msgid "We are confirming your payment. This page updates on its own."
msgstr "Kami sedang mengonfirmasi pembayaran Anda. Halaman ini akan diperbarui dengan sendirinya."

#: src/WooCommerce/Settings.php:140
msgid "Enable"
msgstr "Aktifkan"

#: src/WooCommerce/Settings.php:142
msgid "Take payments with Zeny"
msgstr "Terima pembayaran dengan Zeny"

#: src/WooCommerce/Settings.php:146
msgid "Title"
msgstr "Judul"

#: src/WooCommerce/Settings.php:148
msgid "The payment method name shoppers see at checkout."
msgstr "Nama metode pembayaran yang dilihat pembeli saat checkout."

#: src/WooCommerce/Settings.php:149
msgid "QRIS, virtual account or e-wallet"
msgstr "QRIS, virtual account, atau e-wallet"

#: src/WooCommerce/Settings.php:153
msgid "Description"
msgstr "Deskripsi"

#: src/WooCommerce/Settings.php:155
msgid "Shown under the title at checkout."
msgstr "Ditampilkan di bawah judul saat checkout."

#: src/WooCommerce/Settings.php:156
msgid "You will choose how to pay on the Zeny payment page."
msgstr "Anda akan memilih cara membayar di halaman pembayaran Zeny."

#: src/WooCommerce/Settings.php:160
msgid "Secret API key"
msgstr "Secret API key"

#: src/WooCommerce/Settings.php:162
msgid "From the Zeny dashboard. A key starting with sk_test_ uses Sandbox; sk_live_ uses Production."
msgstr "Dari dasbor Zeny. Key yang diawali sk_test_ memakai Sandbox; sk_live_ memakai Produksi."

#: src/WooCommerce/Settings.php:165
msgid "Webhook secret"
msgstr "Webhook secret"

#: src/WooCommerce/Settings.php:167
msgid "The whsec_ secret of the webhook endpoint you add in the Zeny dashboard."
msgstr "Secret whsec_ dari endpoint webhook yang Anda tambahkan di dasbor Zeny."

#: src/WooCommerce/Settings.php:170
msgid "Link lifetime (minutes)"
msgstr "Masa berlaku tautan (menit)"

#: src/WooCommerce/Settings.php:172
msgid "How long a shopper has to pay, from 15 minutes to 7 days (10080 minutes)."
msgstr "Berapa lama pembeli dapat membayar, dari 15 menit hingga 7 hari (10080 menit)."

#: src/WooCommerce/Settings.php:181
msgid "Payment methods"
msgstr "Metode pembayaran"

#: src/WooCommerce/Settings.php:183
msgid "Instrument codes to offer, separated by commas, such as QRIS, BCA, GOPAY. Leave empty to offer every method."
msgstr "Kode instrumen yang ditawarkan, dipisahkan koma, misalnya QRIS, BCA, GOPAY. Kosongkan untuk menawarkan semua metode."

#: src/WooCommerce/Settings.php:188
msgid "Required payer details"
msgstr "Data pembayar yang wajib"

#: src/WooCommerce/Settings.php:191
msgid "Details the shopper must enter on the Zeny payment page."
msgstr "Data yang wajib diisi pembeli di halaman pembayaran Zeny."

#: src/WooCommerce/Settings.php:194
msgid "Name"
msgstr "Nama"

#: src/WooCommerce/Settings.php:195
msgid "Email"
msgstr "Email"

#: src/WooCommerce/Settings.php:196
msgid "Phone"
msgstr "Telepon"

#: src/WooCommerce/Settings.php:200
msgid "Debug log"
msgstr "Log debug"

#: src/WooCommerce/Settings.php:202
msgid "Log API calls and webhooks"
msgstr "Catat panggilan API dan webhook"

#: src/WooCommerce/Settings.php:203
msgid "Writes to WooCommerce > Status > Logs under \"zeny\". Keys and secrets are never logged."
msgstr "Ditulis ke WooCommerce > Status > Log dengan nama \"zeny\". Key dan secret tidak pernah dicatat."

#: src/WooCommerce/SettingsPanel.php:27
msgid "No key saved"
msgstr "Belum ada key tersimpan"

#: src/WooCommerce/SettingsPanel.php:31
msgid "Connection"
msgstr "Koneksi"

#: src/WooCommerce/SettingsPanel.php:38
msgid "Webhook URL"
msgstr "URL webhook"

#: src/WooCommerce/SettingsPanel.php:41
msgid "In the Zeny dashboard, add a webhook endpoint with this URL and the payment.paid event, then paste its secret in the Webhook secret field above."
msgstr "Di dasbor Zeny, tambahkan endpoint webhook dengan URL ini dan event payment.paid, lalu tempel secret-nya di kolom Webhook secret di atas."

#: src/WooCommerce/SettingsPanel.php:45
msgid "Test"
msgstr "Uji"

#: src/WooCommerce/SettingsPanel.php:50
msgid "Testing…"
msgstr "Menguji…"

#: src/WooCommerce/SettingsPanel.php:51
msgid "The test could not run. Reload the page and try again."
msgstr "Pengujian tidak dapat dijalankan. Muat ulang halaman dan coba lagi."

#: src/WooCommerce/SettingsPanel.php:51
msgid "Test connection"
msgstr "Uji koneksi"

#: src/WooCommerce/SettingsPanel.php:53
msgid "Tests the saved key. Save your changes first."
msgstr "Menguji key yang tersimpan. Simpan perubahan Anda terlebih dahulu."

#. translators: %s: Sandbox or Production.
#: src/WooCommerce/SettingsPanel.php:93
#, php-format
msgid "Connected to Zeny %s."
msgstr "Terhubung ke Zeny %s."

#: src/WooCommerce/SettingsPanel.php:97
msgid "Could not reach Zeny. Check that this server can make outgoing https requests."
msgstr "Tidak dapat menghubungi Zeny. Pastikan server ini dapat membuat permintaan https keluar."

#. translators: 1: error code, 2: request id.
#: src/WooCommerce/SettingsPanel.php:99
#, php-format
msgid "Zeny refused the request: %1$s (request %2$s)."
msgstr "Zeny menolak permintaan: %1$s (request %2$s)."
